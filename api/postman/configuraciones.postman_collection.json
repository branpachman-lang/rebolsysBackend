{
  "info": {
    "name": "REBOLSYS - configuración de habitaciones, mobiliario y productos",
    "description": "Verifica mantenimientos, filtros paginados, estados físicos, historial de mobiliario y stock bajo en el backend real. Crea registros propios de demostración y conserva los que tienen historial. Requiere DATOS_INICIALES_PROPUESTA.sql y DATOS_CONFIGURACIONES.sql. Sin autenticación.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 - Catálogos para formularios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/configuraciones/catalogos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Estados y listas completas',()=>{const c=pm.response.json();pm.expect(c.estadosHabitacion).to.include('MANTENIMIENTO');pm.expect(c.estadosItem).to.include('En habitacion');pm.expect(c.estadosConservacion).to.include('EN_REPARACION');pm.expect(c.tiposHabitacion).to.be.an('array');pm.expect(c.categorias).to.be.an('array');});",
              "const clave=Date.now().toString(36)+Math.random().toString(36).slice(2,5);pm.collectionVariables.set('clave',clave);pm.collectionVariables.set('numero','C'+Date.now().toString(36));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Operador existente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/recepcion/catalogos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Existe operador con turno abierto',()=>{pm.expect(pm.response.json().turnosAbiertos.length).to.be.above(0);});",
              "pm.collectionVariables.set('usuario',pm.response.json().turnosAbiertos[0].idUsuario);"
            ]
          }
        }
      ]
    },
