  "item": [
    {
      "name": "Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Backend disponible',()=>pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
