{
  "info": {
    "name": "REBOLSYS - flujo de reservas asistidas",
    "description": "Crea datos nuevos de demostración en Oracle local y los conserva. Requiere DATOS_INICIALES_PROPUESTA.sql, V8 y DATOS_RESERVAS.sql. Comprueba anticipo, ocupantes al ingreso, consumo consolidado y separado, boletas internas, saldo y salida. Sin SUNAT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 - Preparación de reserva asistida",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/recepcion/catalogos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const c=pm.response.json();\npm.test('Operador, turno y tipo de gasto preparados',()=>{\n pm.expect(c.turnosAbiertos.length).to.be.above(0);\n pm.expect(c.tiposGasto.length).to.be.above(0);\n pm.expect(c.tiposDocumento.some(d=>d.codigoSunat==='1')).to.eql(true);\n});\nif(c.turnosAbiertos.length){\n const turno=c.turnosAbiertos[0];\n pm.collectionVariables.set('idUsuario',turno.idUsuario);\n pm.collectionVariables.set('idTurno',turno.idTurno);\n}\nconst dni=c.tiposDocumento.find(d=>d.codigoSunat==='1');\nif(dni)pm.collectionVariables.set('idTipoDocumento',dni.id);\nif(c.tiposGasto.length)pm.collectionVariables.set('idTipoMovimiento',c.tiposGasto[0].id);\nconst n=Date.now().toString();\npm.collectionVariables.set('numeroCuarto','P'+n.slice(-8));\npm.collectionVariables.set('documentoAdulto',n.slice(-8));\npm.collectionVariables.set('documentoMenor',(Number(n.slice(-8))+1).toString().padStart(8,'0').slice(-8));\npm.collectionVariables.set('clave',n);\nconst hoy=new Date().toLocaleDateString('en-CA',{timeZone:'America/Lima'});\nconst f=new Date(hoy+'T12:00:00Z');f.setUTCDate(f.getUTCDate()+1);\npm.collectionVariables.set('fechaDesde',f.toISOString().slice(0,10));\npm.collectionVariables.set('fechaIngreso',f.toISOString().slice(0,10)+'T14:00:00');\nf.setUTCDate(f.getUTCDate()+1);\npm.collectionVariables.set('fechaHasta',f.toISOString().slice(0,10));\npm.collectionVariables.set('fechaSalida',f.toISOString().slice(0,10)+'T12:00:00');\npm.collectionVariables.set('nacimientoMenor',(Number(hoy.slice(0,4))-4)+'-01-01');",
              "const preparacion=pm.response.json();pm.test('Forma de pago preparada',()=>pm.expect(preparacion.formasPago.length).to.be.above(0));pm.collectionVariables.set('idFormaPago',preparacion.formasPago[0].id);",
              "const local=d=>new Intl.DateTimeFormat('sv-SE',{timeZone:'America/Lima',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).format(d).replace(' ','T');pm.collectionVariables.set('fechaIngreso',local(new Date(Date.now()-3600000)));pm.collectionVariables.set('fechaSalida',local(new Date(Date.now()+86400000)));"
            ]
          }
        }
      ]
    },
