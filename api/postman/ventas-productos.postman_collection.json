    {
      "name": "08 - Crear carrito con dos productos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/ventas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveRegistro\": \"carrito-{{clave}}\",\n  \"idUsuario\": \"{{idUsuario}}\",\n  \"idClienteComprador\": \"{{idCliente}}\",\n  \"modalidadCobro\": \"SEPARADA\",\n  \"detalles\": [\n    {\n      \"idProducto\": \"{{idAgua}}\",\n      \"cantidad\": 2\n    },\n    {\n      \"idProducto\": \"{{idGalletas}}\",\n      \"cantidad\": 3\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const v=pm.response.json();pm.collectionVariables.set('idVenta',v.idVenta);pm.test('Borrador por 13 soles',()=>{pm.expect(v.estadoVenta).to.eql('BORRADOR');pm.expect(v.detalles).to.have.lengthOf(2);pm.expect(v.total).to.eql(13);});"
            ]
          }
        }
      ]
    },
