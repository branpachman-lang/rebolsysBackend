{
  "info": {
    "name": "REBOLSYS - venta de varios productos y cobro directo",
    "description": "Crea dos productos y compradores de demostración. Prueba carrito, edición, confirmación atómica, stock, pagos y boleta/factura internas. Conserva sus datos. Requiere preparación original, de reservas y DATOS_VENTAS.sql. Sin autenticación ni SUNAT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 - Preparar operador, turno y documentos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/recepcion/catalogos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const c=pm.response.json();pm.test('Preparación disponible',()=>{pm.expect(c.turnosAbiertos.length).to.be.above(0);pm.expect(c.formasPago.length).to.be.above(0);pm.expect(c.tiposDocumento.some(t=>t.codigoSunat==='1')).to.eql(true);pm.expect(c.tiposDocumento.some(t=>t.codigoSunat==='6')).to.eql(true);});const turno=c.turnosAbiertos[0];pm.collectionVariables.set('idUsuario',turno.idUsuario);pm.collectionVariables.set('idTurno',turno.idTurno);pm.collectionVariables.set('idFormaPago',c.formasPago[0].id);pm.collectionVariables.set('idDni',c.tiposDocumento.find(t=>t.codigoSunat==='1').id);pm.collectionVariables.set('idRuc',c.tiposDocumento.find(t=>t.codigoSunat==='6').id);",
              "const n=Date.now().toString();pm.collectionVariables.set('clave',n+'-'+Math.random().toString(36).slice(2,7));pm.collectionVariables.set('dni',n.slice(-8));pm.collectionVariables.set('ruc','20'+n.slice(-8)+'1');"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Crear categoría de demostración",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/categorias",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreCategoria\": \"Venta {{clave}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('idCategoria',pm.response.json().idCategoria);"
            ]
          }
        }
      ]
    },
