# Plantilla de variables: configurar en el IDE o terminal.
# Spring Boot no carga este archivo automáticamente.
# Para usar application-prod.yaml:
SPRING_PROFILES_ACTIVE=prod
DB_URL=
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
APISPERU_TOKEN=
APISPERU_BASE_URL=https://dniruc.apisperu.com/api/v1
APISPERU_TIMEOUT_MILLIS=8000

# Facturación beta: credencial independiente de consultas DNI/RUC.
# Token de facturación o usuario/password (el backend obtiene y renueva su sesión).
FACTURACION_HABILITADA=false
FACTURACION_APISPERU_URL=https://facturacion.apisperu.com/api/v1
FACTURACION_APISPERU_TOKEN=
FACTURACION_APISPERU_USUARIO=
FACTURACION_APISPERU_PASSWORD=
FACTURACION_APISPERU_ID_EMPRESA=
FACTURACION_EMISOR_RUC=
FACTURACION_EMISOR_RAZON_SOCIAL=
FACTURACION_EMISOR_DIRECCION=
FACTURACION_EMISOR_UBIGEO=
FACTURACION_EMISOR_DEPARTAMENTO=
FACTURACION_EMISOR_PROVINCIA=
FACTURACION_EMISOR_DISTRITO=
FACTURACION_TIMEOUT_MILLIS=8000
